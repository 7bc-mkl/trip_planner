$ agent-browser eval 
(async () => {
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
  const l = document.querySelector('.upload-dropzone__label');
  const bin=atob(''); const u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);
  const dt=new DataTransfer(); dt.items.add(new File([u],'dropped-single.png',{type:'image/png'}));
  const ev=t=>new DragEvent(t,{bubbles:true,cancelable:true,dataTransfer:dt});
  l.dispatchEvent(ev('dragenter')); l.dispatchEvent(ev('dragover')); await sleep(150);
  const during = l.getAttribute('data-drag-over');
  l.dispatchEvent(ev('drop')); await sleep(2500);
  return 'during='+during+' after='+(l.getAttribute('data-drag-over')||'off')+' list='+[...document.querySelectorAll('.attachment-row__name')].map(e=>e.textContent).join(',');
})()
"during=true after=off list=photo-b.png,dropped-single.png"
