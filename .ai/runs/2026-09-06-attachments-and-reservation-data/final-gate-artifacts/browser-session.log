$ agent-browser eval 
(() => {
  const label = document.querySelector('.upload-dropzone__label');
  if (!label) return 'NO LABEL';
  const b64 = { 'photo-a.png': ['','image/png'], 'bilet.pdf': ['JVBERi0xLjQKMSAwIG9iajw8L1R5cGUvQ2F0YWxvZy9QYWdlcyAyIDAgUj4+ZW5kb2JqCjIgMCBvYmo8PC9UeXBlL1BhZ2VzL0tpZHNbMyAwIFJdL0NvdW50IDE+PmVuZG9iagozIDAgb2JqPDwvVHlwZS9QYWdlL1BhcmVudCAyIDAgUi9NZWRpYUJveFswIDAgMjAwIDIwMF0+PmVuZG9iagp0cmFpbGVyPDwvUm9vdCAxIDAgUj4+CiUlRU9GCg==','application/pdf'] };
  const mk = (name) => { const [d,t]=b64[name]; const bin=atob(d); const u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i); return new File([u], name, {type:t}); };
  const dt = new DataTransfer();
  dt.items.add(mk('photo-a.png'));
  dt.items.add(mk('bilet.pdf'));
  window.__qaDT = dt;
  const ev = (type) => new DragEvent(type, {bubbles:true, cancelable:true, dataTransfer: dt});
  label.dispatchEvent(ev('dragenter'));
  label.dispatchEvent(ev('dragover'));
  return 'dragenter+dragover dispatched; files=' + dt.files.length;
})()
